# Supabase Postgres (Project Settings -> Database -> Connection string)
# Pooled connection (port 6543) used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) used by Prisma migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Public site URL, used for canonical links and the sitemap
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Random string used to hash enquiry IP addresses for rate limiting
ENQUIRY_IP_SALT="change-me"

# Optional: email notification for new enquiries via Resend
RESEND_API_KEY=""
ENQUIRY_NOTIFY_FROM="Soveni Website <website@your-verified-domain>"
ENQUIRY_NOTIFY_TO=""
